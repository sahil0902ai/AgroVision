{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agrovision-lsgn.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://agrovision-lsgn.onrender.com/uploads/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/overview",
      "destination": "/overview.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    },
    {
      "source": "/reports",
      "destination": "/reports.html"
    },
    {
      "source": "/assistant",
      "destination": "/assistant.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/analysis_detail",
      "destination": "/analysis_detail.html"
    },
    {
      "source": "/agrovision",
      "destination": "/index.html"
    },
    {
      "source": "/agrovision/",
      "destination": "/index.html"
    },
    {
      "source": "/agrovision/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
